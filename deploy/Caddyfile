{
    email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
    encode gzip zstd

    handle_path /api/* {
        reverse_proxy api:8000
    }

    handle /mlflow* {
        reverse_proxy mlflow:5000
    }

    handle_path /models/* {
        root * /srv/arsl-models
        file_server
        header Content-Disposition "attachment"
    }

    handle {
        reverse_proxy frontend:80
    }
}
